# Application Server Configuration
APP_ENV=development
PORT=8000
HOST=0.0.0.0
PUBLIC_BASE_URL=https://your-domain.ngrok-free.app

# Database & Sync Path (Starts 100% clean, 0 old data)
DATABASE_PATH=data/teams_365_agent.db
DATA_SYNC_DIR=data/files_sync

# Live LLM Configuration (Tier 1: Groq, Tier 2: Gemini, Tier 3: Deterministic Fallback)
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
ENABLE_EXTERNAL_LLM=true

# ==============================================================================
# Microsoft 365 Azure Entra ID Credentials (Fill from Azure Portal)
# ==============================================================================
# Step 1: Azure Portal -> App Registrations -> Overview -> Application (client) ID
AZURE_CLIENT_ID=

# Step 2: Azure Portal -> App Registrations -> Certificates & secrets -> Value (NOT Secret ID)
AZURE_CLIENT_SECRET=

# Step 3: Azure Portal -> App Registrations -> Overview -> Directory (tenant) ID
AZURE_TENANT_ID=

# Step 4: Comma-separated list of designated Project Group Chat IDs to monitor
# (The app strictly ignores any personal 1:1 chat or unlisted group chat)
AUTHORIZED_GROUP_CHAT_IDS=19:sample-project-group-chat-id@thread.v2
